<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gimbal_control</name>
  <version>0.0.0</version>
  <description>Fixed-rate gimbal control loop: proposal weighting, feedforward and feedback joint-rate commands.</description>
  <maintainer email="haefner.maxim@gmail.com">Maxim Häfner</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- pip, no rosdep key: adafruit-circuitpython-bno08x, adafruit-extended-bus -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
